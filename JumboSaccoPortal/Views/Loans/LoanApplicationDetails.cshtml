@model JumboSaccoPortal.Models.infoclasses.OnlineLoanApplication

@{
    ViewBag.Title = "Online Loan Applications";
}

<div class="pageheader">
    <h1>Loan Application Details - @Model.LoanAppID</h1>
    <a href="@Url.Action("Logout", "Dashboard")">
        <i class="fa fa-power-off"></i>
    </a>
</div>

<div class="pagecontent">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error">
            @TempData["ErrorMessage"]
        </div>
    }

<div class="innercontent">
    <div class="section-view">
        <h2>Loan Details</h2>
        <p><strong>Loan Type: </strong>@Model.LoanType</p>
        <p><strong>Loan Status: </strong>@Model.Status</p>
        <p><strong>Requested Amount: </strong>@Model.RequestedAmount Kshs</p>
        <p><strong>Request Date: </strong>@Model.RequestDate</p>
        <p><strong>Last Updated Date: </strong>@Model.LastUpdateDate</p>
        <p><strong>Total Amount Guaranteed So Far: </strong>@Model.TotalGuaranteed</p>
    </div>
    @if (Model.Status == "New")
    {
        <div class="section-view">
            <h3>Modify Loan Application</h3>

            <p class="text-muted">
                You can change the loan type and requested amount.
                Documents are optional. Only documents you upload will be replaced.
            </p>

            @using (Html.BeginForm(
                "ModifyLoanApplication",
                "Loans",
                FormMethod.Post,
                new
                {
                    enctype = "multipart/form-data",
                    id = "modifyLoanApplicationForm"
                }))
            {
                @Html.AntiForgeryToken()

                @Html.Hidden(
                    "loanId",
                    Model.LoanAppID)

                <!-- Loan Type -->
                <div class="form-group">
                    <label for="loanType">
                        <strong>Loan Type:</strong>
                    </label>

                    <select id="loanType"
                            name="loanType"
                            class="form-control"
                            required>

                        <option value="">
                            -- Select Loan Type --
                        </option>

                        @if (ViewBag.LoanTypes != null)
                        {
                            foreach (var loanType in ViewBag.LoanTypes)
                            {
                                <option value="@loanType.LoanCode"
                                        @(loanType.LoanCode == Model.LoanTypeCode ? "selected" : "")>

                                    @loanType.LoanDescription

                                </option>
                            }
                        }
                    </select>
                </div>

                <!-- Requested Amount -->
                <div class="form-group">
                    <label for="requestedAmount">
                        <strong>Requested Amount:</strong>
                    </label>

                    <input type="number"
                           id="requestedAmount"
                           name="requestedAmount"
                           class="form-control"
                           value="@Model.RequestedAmount"
                           min="1"
                           step="0.01"
                           required />

                    <small class="text-muted">
                        Enter the amount you are requesting.
                    </small>
                </div>

                <hr />

                <h4>Update Documents</h4>

                <p class="text-muted">
                    Leave a document blank if you do not want to change it.
                </p>

                <!-- Payslip 1 -->
                <div class="form-group">
                    <label for="Payslip1">
                        <strong>First Payslip</strong>
                    </label>

                    <input type="file"
                           id="Payslip1"
                           name="Payslip1"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />
                </div>

                <!-- Payslip 2 -->
                <div class="form-group">
                    <label for="Payslip2">
                        <strong>Second Payslip</strong>
                    </label>

                    <input type="file"
                           id="Payslip2"
                           name="Payslip2"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />
                </div>

                <!-- Payslip 3 -->
                <div class="form-group">
                    <label for="Payslip3">
                        <strong>Third Payslip</strong>
                    </label>

                    <input type="file"
                           id="Payslip3"
                           name="Payslip3"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />
                </div>

                <!-- ID Copy -->
                <div class="form-group">
                    <label for="IDCopy">
                        <strong>ID Copy</strong>
                    </label>

                    <input type="file"
                           id="IDCopy"
                           name="IDCopy"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />
                </div>

                <!-- KRA PIN -->
                <div class="form-group">
                    <label for="KRAPin">
                        <strong>KRA PIN</strong>
                    </label>

                    <input type="file"
                           id="KRAPin"
                           name="KRAPin"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />
                </div>

                <!-- Collateral -->
                <div class="form-group">
                    <label for="CollateralCopy">
                        <strong>Collateral Document</strong>
                    </label>

                    <input type="file"
                           id="CollateralCopy"
                           name="CollateralCopy"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />
                </div>

                <div class="form-group mt-4">
                    <button type="submit"
                            class="btn btn-primary"
                            id="modifyLoanBtn">

                        Modify Loan Application
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            onclick="window.location.reload();">

                        Cancel
                    </button>
                </div>
            }
        </div>
    }
    <!-- Add Guarantor Section -->
    <div class="section-view">
        <h3>Add Guarantor</h3>
        <div>
            @using (Html.BeginForm("SearchGuarantor", "Loans", FormMethod.Post, new { id = "searchGuarantorForm" }))
            {
                @Html.Hidden("loanId", Model.LoanAppID)
                <div class="form-group">
                    <label for="guarantorId">Guarantor Member Number:</label>
                    <input type="text" id="guarantorId" name="guarantorId" class="form-control" required />
                </div>
                <button type="submit" class="btn btn-primary">Search</button>
            }
        </div>

        <div id="guarantorDetails" style="display: none;">
            @using (Html.BeginForm("AddGuarantor", "Loans", FormMethod.Post))
            {
                @Html.Hidden("loanId", Model.LoanAppID)
                @Html.Hidden("guarantorId", "", new { id = "addGuarantorId" })

                <div class="form-group">
                    <label>Name:</label>
                    <span id="guarantorName"></span>
                </div>
                <button type="submit" class="btn btn-success">Add Guarantor</button>
            }
        </div>
    </div>
    <!-- Add Collateral Section -->
    <div class="section-view mt-5">
        <h3>Add Collateral</h3>

        @using (Html.BeginForm("AddCollateral", "Loans", FormMethod.Post, new { id = "addCollateralForm" }))
        {
            @Html.Hidden("loanId", Model.LoanAppID)

            <div class="form-group mb-4">
                <label for="collateralId" class="mb-2"><strong>Select Collateral:</strong></label>
                <select id="collateralId" name="collateralId" class="form-control" required>
                    <option value="">-- Select Collateral --</option>
                    @*  foreach (var item in Model.AvailableCollaterals)
                        {
                            <option value="@item.CollateralID" data-value="@item.Value">@item.CollateralName</option>
                        }
                    *@
                </select>
            </div>

            <div class="form-group mb-4">
                <label class="mb-2"><strong>Collateral Value:</strong></label>
                <input type="text" id="collateralValue" class="form-control" readonly />
            </div>

            <div class="form-group mb-4">
                <label for="collateralAmount" class="mb-2"><strong>Amount to Pledge:</strong></label>
                <input type="number" id="collateralAmount" name="collateralAmount" class="form-control" required min="1" />
                <small class="text-muted">Amount cannot exceed the collateral value.</small>
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-success">Add Collateral</button>
            </div>
        }
    </div>

    <div class="openloansarea">
        @if (Model.OnlineGuarantors.Any())
        {
            <h3>Loan Guarantors</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Guarantor Name</th>
                        <th>Guarantorship Amount</th>
                        <th>Guarantorship Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guarantor in Model.OnlineGuarantors)
                    {
                        <tr>
                            <td>@guarantor.GuarantorName</td>
                            <td>@guarantor.ApprovedAmount</td>
                            <td>@guarantor.GuarantorshipStatus</td>
                            <td>
                                @if (@guarantor.GuarantorshipStatus == "Removed")
                                {
                                }
                                else
                                {
                                    <button onclick="window.location.href = '@Url.Action("RemoveGuarantor", "Loans", new { loanid = Model.LoanAppID, guarantorshipid = guarantor.LoanAppID })'">Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
</div>

    <script>
        $(document).ready(function () {
            // Handle guarantor search form submission with AJAX
            $('#searchGuarantorForm').submit(function (e) {
                e.preventDefault();

                $.ajax({
                    url: $(this).attr('action'),
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            $('#guarantorName').text(response.guarantorName);
                            $('#addGuarantorId').val(response.guarantorId);
                            $('#guarantorDetails').show();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('An error occurred while searching for the guarantor.');
                    }
                });
            });
        });

        // Handle collateral selection and validation
        $('#collateralId').change(function () {
            const selectedValue = $('#collateralId option:selected').data('value') || 0;
            $('#collateralValue').val(selectedValue);
            $('#collateralAmount').val('');
        });

        // Validate collateral amount before submitting
        $('#addCollateralForm').submit(function (e) {
            const maxValue = parseFloat($('#collateralValue').val()) || 0;
            const enteredValue = parseFloat($('#collateralAmount').val()) || 0;

            if (enteredValue > maxValue) {
                e.preventDefault();
                alert('The pledged amount cannot exceed the collateral value.');
            }
        });

    </script>

