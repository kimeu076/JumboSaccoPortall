@model JumboSaccoPortal.Models.infoclasses.LoanCalculatorTypes

@{
    ViewBag.Title = "My Loans";
}

<div class="pageheader">
    <h1>My Loans</h1>
    <a href="@Url.Action("Logout", "Dashboard")">
        <i class="fa fa-power-off"></i>
    </a>
</div>

<div class="pagecontent">
    <div class="innercontent">

        ```
        <div class="section-view">
            <p>On this page, you can calculate a loan and find out its repayments.</p>
        </div>

        <div class="section-view">

            <div class="cpgroup">
                <label for="loantype">Loan Type:</label>

                <select id="loantype" name="loantype" required>
                    <option value="">-- Select Loan Type --</option>

                    @if (Model != null && Model.LoanTypes != null)
                    {
                        foreach (var loantype in Model.LoanTypes)
                        {
                            <option value="@loantype.LoanCode">
                                @loantype.LoanDescription
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="cpgroup">
                <label for="loanAmount">Loan Amount (KES):</label>

                <input type="number"
                       id="loanAmount"
                       name="loanAmount"
                       min="1"
                       required>
            </div>

            <div class="cpgroup">
                <label for="loanPeriod">Loan Period (Months):</label>

                <input type="number"
                       id="loanPeriod"
                       name="loanPeriod"
                       min="1"
                       required>
            </div>

            <div class="cpgroup">
                <button type="button" id="calculateLoan">
                    Calculate Loan
                </button>
            </div>

        </div>

        <div id="loanCalculationResults" style="display:none">
        </div>

        <div id="repaymentSchedule">
        </div>

    </div>
    ```

</div>

<script type="text/javascript">

    document.addEventListener('DOMContentLoaded', function () {

        const calculateButton =
            document.getElementById('calculateLoan');

        const loanTypeDropdown =
            document.getElementById('loantype');

        const loanAmountInput =
            document.getElementById('loanAmount');

        const loanPeriodInput =
            document.getElementById('loanPeriod');

        const resultsDiv =
            document.getElementById('loanCalculationResults');

        const scheduleDiv =
            document.getElementById('repaymentSchedule');


        calculateButton.addEventListener('click', function () {

            const selectedLoanCode =
                loanTypeDropdown.value;

            const loanAmount =
                parseFloat(loanAmountInput.value);

            const loanPeriodMonths =
                parseInt(loanPeriodInput.value);


            /*
             * ============================================================
             * VALIDATE INPUT
             * ============================================================
             */

            if (
                !selectedLoanCode ||
                isNaN(loanAmount) ||
                isNaN(loanPeriodMonths) ||
                loanAmount <= 0 ||
                loanPeriodMonths <= 0
            ) {

                resultsDiv.innerHTML =
                    '<p style="color: red;">' +
                    'Please select a loan type and enter valid ' +
                    'loan amount and period.' +
                    '</p>';

                scheduleDiv.innerHTML = '';

                resultsDiv.style.display = 'block';

                return;
            }


            /*
             * ============================================================
             * GET LOAN TYPES
             * ============================================================
             */

            const loanTypes =
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        Model.LoanTypes
                    )
                );


            const selectedLoan =
                loanTypes.find(
                    loan => loan.LoanCode === selectedLoanCode
                );


            if (!selectedLoan) {

                resultsDiv.innerHTML =
                    '<p style="color: red;">' +
                    'Selected loan type not found.' +
                    '</p>';

                scheduleDiv.innerHTML = '';

                resultsDiv.style.display = 'block';

                return;
            }


            /*
             * ============================================================
             * LOAN SETUP
             * ============================================================
             */

            const annualInterestRate =
                parseFloat(selectedLoan.LoanInterest) / 100;

            const maximumInstallments =
                parseFloat(selectedLoan.LoanInstallments);

            const repaymentMethod =
                selectedLoan.LoanRepaymentMethod;


            /*
             * ============================================================
             * CHECK MAXIMUM INSTALLMENTS
             * ============================================================
             */

            if (loanPeriodMonths > maximumInstallments) {

                resultsDiv.innerHTML =
                    `<div class="alert alert-error">
                        Loan period (${loanPeriodMonths} months)
                        cannot be longer than the maximum installments
                        which are (${maximumInstallments} months).
                    </div>`;

                scheduleDiv.innerHTML = '';

                resultsDiv.style.display = 'block';

                return;
            }


            /*
             * ============================================================
             * GET CHARGES FROM BUSINESS CENTRAL
             * ============================================================
             *
             * We still call BC so that appraisal and insurance remain
             * available from the NAV/BC source of truth.
             *
             * They are NOT added to the monthly repayment below.
             */

            calculateButton.disabled = true;
            calculateButton.innerText = 'Calculating...';


            $.ajax({

                url: '@Url.Action("GetLoanCharges", "Loans")',

                type: 'GET',

                data: {
                    loanProductType: selectedLoanCode,
                    loanAmount: loanAmount
                },


                success: function (response) {

                    if (!response || !response.success) {

                        resultsDiv.innerHTML =
                            `<p style="color:red;">
                                ${response && response.message
                                    ? response.message
                                    : 'Unable to retrieve loan charges.'}
                            </p>`;

                        scheduleDiv.innerHTML = '';

                        resultsDiv.style.display = 'block';

                        calculateButton.disabled = false;
                        calculateButton.innerText =
                            'Calculate Loan';

                        return;
                    }


                    /*
                     * ====================================================
                     * BC CHARGES
                     * ====================================================
                     *
                     * These are retrieved from BC but are NOT included
                     * in each month's repayment.
                     */

                    //const totalAppraisal =
                    //    parseFloat(response.appraisal) || 0;

                    //const totalInsurance =
                    //    parseFloat(response.insurance) || 0;


                    //console.log("Loan Product:", selectedLoanCode);
                    //console.log("Loan Amount:", loanAmount);
                    //console.log("Appraisal:", totalAppraisal);
                    //console.log("Insurance:", totalInsurance);


                    /*
                     * ====================================================
                     * GENERATE REPAYMENT SCHEDULE
                     * ====================================================
                     */

                    let scheduleHTML = '';

                    const currentDate =
                        new Date();

                    let currentMonth =
                        currentDate.getMonth();

                    let currentYear =
                        currentDate.getFullYear();

                    let loanBalance =
                        loanAmount;


                    for (
                        let i = 1;
                        i <= loanPeriodMonths;
                        i++
                    ) {

                        let interestPayment = 0;
                        let principalPayment = 0;
                        let totalPayment = 0;


                        /*
                         * =================================================
                         * REDUCING BALANCE
                         * =================================================
                         */

                        if (
                            repaymentMethod ===
                            'Reducing Balance'
                        ) {

                            principalPayment =
                                parseFloat(
                                    (
                                        loanAmount /
                                        loanPeriodMonths
                                    ).toFixed(2)
                                );


                            const monthlyInterestRate =
                                annualInterestRate / 12;


                            interestPayment =
                                parseFloat(
                                    (
                                        monthlyInterestRate *
                                        loanBalance
                                    ).toFixed(2)
                                );


                            /*
                             * Total repayment is ONLY:
                             *
                             * Principal + Interest
                             */

                            totalPayment =
                                parseFloat(
                                    (
                                        principalPayment +
                                        interestPayment
                                    ).toFixed(2)
                                );


                            loanBalance -=
                                principalPayment;
                        }


                        /*
                         * =================================================
                         * STRAIGHT LINE
                         * =================================================
                         */

                        else if (
                            repaymentMethod ===
                            'Straight Line'
                        ) {

                            principalPayment =
                                parseFloat(
                                    (
                                        loanAmount /
                                        loanPeriodMonths
                                    ).toFixed(2)
                                );


                            const monthlyInterestRate =
                                annualInterestRate / 12;


                            interestPayment =
                                parseFloat(
                                    (
                                        monthlyInterestRate *
                                        loanAmount
                                    ).toFixed(2)
                                );


                            /*
                             * Total repayment is ONLY:
                             *
                             * Principal + Interest
                             */

                            totalPayment =
                                parseFloat(
                                    (
                                        principalPayment +
                                        interestPayment
                                    ).toFixed(2)
                                );


                            loanBalance -=
                                principalPayment;
                        }


                        /*
                         * =================================================
                         * AMORTISED
                         * =================================================
                         */

                        else if (
                            repaymentMethod ===
                            'Amortised'
                        ) {

                            const monthlyInterestRate =
                                annualInterestRate / 12;


                            const powerFactor =
                                Math.pow(
                                    1 + monthlyInterestRate,
                                    -loanPeriodMonths
                                );


                            let totalMonthlyRepayment;


                            if (
                                monthlyInterestRate === 0
                            ) {

                                totalMonthlyRepayment =
                                    loanAmount /
                                    loanPeriodMonths;

                            }
                            else {

                                totalMonthlyRepayment =
                                    (
                                        monthlyInterestRate /
                                        (1 - powerFactor)
                                    ) *
                                    loanAmount;
                            }


                            totalMonthlyRepayment =
                                parseFloat(
                                    totalMonthlyRepayment.toFixed(2)
                                );


                            interestPayment =
                                parseFloat(
                                    (
                                        monthlyInterestRate *
                                        loanBalance
                                    ).toFixed(2)
                                );


                            principalPayment =
                                parseFloat(
                                    (
                                        totalMonthlyRepayment -
                                        interestPayment
                                    ).toFixed(2)
                                );


                            /*
                             * Amortised repayment is:
                             *
                             * Principal + Interest
                             */

                            totalPayment =
                                parseFloat(
                                    (
                                        principalPayment +
                                        interestPayment
                                    ).toFixed(2)
                                );


                            loanBalance -=
                                principalPayment;
                        }


                        /*
                         * =================================================
                         * DEFAULT
                         * =================================================
                         */

                        else {

                            principalPayment =
                                parseFloat(
                                    (
                                        loanAmount /
                                        loanPeriodMonths
                                    ).toFixed(2)
                                );


                            const monthlyInterestRate =
                                annualInterestRate / 12;


                            interestPayment =
                                parseFloat(
                                    (
                                        monthlyInterestRate *
                                        loanBalance
                                    ).toFixed(2)
                                );


                            totalPayment =
                                parseFloat(
                                    (
                                        principalPayment +
                                        interestPayment
                                    ).toFixed(2)
                                );


                            loanBalance -=
                                principalPayment;
                        }


                        /*
                         * =================================================
                         * FORMAT VALUES
                         * =================================================
                         */

                        const formattedBalance =
                            Math.max(0, loanBalance)
                                .toLocaleString(
                                    'en-KE',
                                    {
                                        style: 'currency',
                                        currency: 'KES'
                                    }
                                );


                        const formattedPrincipal =
                            Math.max(0, principalPayment)
                                .toLocaleString(
                                    'en-KE',
                                    {
                                        style: 'currency',
                                        currency: 'KES'
                                    }
                                );


                        const formattedInterest =
                            Math.max(0, interestPayment)
                                .toLocaleString(
                                    'en-KE',
                                    {
                                        style: 'currency',
                                        currency: 'KES'
                                    }
                                );


                        const formattedTotalRepayment =
                            Math.max(0, totalPayment)
                                .toLocaleString(
                                    'en-KE',
                                    {
                                        style: 'currency',
                                        currency: 'KES'
                                    }
                                );


                        const monthName =
                            new Intl.DateTimeFormat(
                                'en-US',
                                {
                                    month: 'long'
                                }
                            ).format(
                                new Date(
                                    currentYear,
                                    currentMonth,
                                    1
                                )
                            );


                        /*
                         * =================================================
                         * SCHEDULE
                         * =================================================
                         */

                        scheduleHTML += `
                            <div>

                                <strong>
                                    ${monthName} ${currentYear}
                                </strong>

                                <p>
                                    Principal:
                                    ${formattedPrincipal}
                                </p>

                                <p>
                                    Interest:
                                    ${formattedInterest}
                                </p>

                                <p>
                                    Total Repayment:
                                    ${formattedTotalRepayment}
                                </p>

                                <p>
                                    Balance:
                                    ${formattedBalance}
                                </p>

                            </div>
                        `;


                        currentMonth++;


                        if (currentMonth > 11) {

                            currentMonth = 0;
                            currentYear++;
                        }
                    }


                    scheduleDiv.innerHTML =
                        scheduleHTML;


                    /*
                     * ====================================================
                     * RESULTS
                     * ====================================================
                     */

                    const formattedAmount =
                        loanAmount.toLocaleString(
                            'en-KE',
                            {
                                style: 'currency',
                                currency: 'KES'
                            }
                        );


                    //const formattedAppraisal =
                    //    totalAppraisal.toLocaleString(
                    //        'en-KE',
                    //        {
                    //            style: 'currency',
                    //            currency: 'KES'
                    //        }
                    //    );


                    //const formattedInsurance =
                    //    totalInsurance.toLocaleString(
                    //        'en-KE',
                    //        {
                    //            style: 'currency',
                    //            currency: 'KES'
                    //        }
                    //    );


                    resultsDiv.innerHTML = `
                        <h3>Loan Calculation Results</h3>

                        <p>
                            <strong>Loan Type:</strong>
                            ${selectedLoan.LoanDescription}
                        </p>

                        <p>
                            <strong>Loan Amount Applied For:</strong>
                            ${formattedAmount}
                        </p>

                        <p>
                            <strong>Loan Period:</strong>
                            ${loanPeriodMonths} months
                        </p>


                    `;


                    resultsDiv.style.display =
                        'block';


                    calculateButton.disabled = false;

                    calculateButton.innerText =
                        'Calculate Loan';
                },


                /*
                 * ========================================================
                 * AJAX ERROR
                 * ========================================================
                 */

                error: function (xhr, status, error) {

                    console.log("Status:", status);
                    console.log("Error:", error);
                    console.log("HTTP Status:", xhr.status);
                    console.log("Response:", xhr.responseText);


                    resultsDiv.innerHTML =
                        '<p style="color:red;">' +
                        'Unable to retrieve loan charges.<br>' +
                        'HTTP Status: ' + xhr.status +
                        '<br>Error: ' + error +
                        '<br>Response: ' + xhr.responseText +
                        '</p>';


                    scheduleDiv.innerHTML = '';

                    resultsDiv.style.display =
                        'block';


                    calculateButton.disabled = false;

                    calculateButton.innerText =
                        'Calculate Loan';
                }

            });

        });

    });

</script>
