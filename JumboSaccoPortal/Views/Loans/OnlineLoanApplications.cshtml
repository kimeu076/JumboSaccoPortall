@model JumboSaccoPortal.Models.infoclasses.LoanStatusGroups

@{
    ViewBag.Title = "Online Loan Applications";
}

<div class="pageheader">
    <h1>Online Loan Applications</h1>
    <a href="@Url.Action("Logout", "Dashboard")">
        <i class="fa fa-power-off"></i>
    </a>
</div>
<div class="pagecontent">
    <div class="innercontent">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error">
                @TempData["ErrorMessage"]
            </div>
        }
        <div class="openloansarea">
            @if (Model.NewLoans.Any())
            {
                <h3>New Applications</h3>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Loan ID</th>
                            <th>Amount</th>
                            <th>Type</th>
                            <th>Request Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.NewLoans)
                        {
                            <tr>
                                <td>@loan.LoanAppID</td>
                                <td>@loan.RequestedAmount</td>
                                <td>@loan.LoanType</td>
                                <td>@loan.RequestDate</td>
                                <td>@loan.Status</td>
                                <td>
                                    <button onclick="window.location.href = '@Url.Action("LoanApplicationDetails", "Loans", new { loanid = loan.LoanAppID})'">Details</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-error">
                    No Pending Loan Applications Found.
                </div>
            }
        </div>

        <div class="openloansarea">

            @if (Model.ApprovedLoans.Any())
            {
                <h3>Approved Applications</h3>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Loan ID</th>
                            <th>Amount</th>
                            <th>Type</th>
                            <th>Request Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var loan in Model.ApprovedLoans)
                        {
                            <tr>
                                <td>@loan.LoanAppID</td>
                                <td>@loan.RequestedAmount</td>
                                <td>@loan.LoanType</td>
                                <td>@loan.RequestDate</td>
                                <td>@loan.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-error">
                    No Approved Loan Applications Found.
                </div>
            }
        </div>

    </div>
</div>

