@{
    ViewBag.Title = "Set Password";
    Layout = "~/Views/Shared/_LoginsLayout.cshtml";
}

<section class="loginarea">
    <div class="top-side">
        <img src="~/Content/images/generallogo.png" alt="Jumbo Sacco" class="topsidemage" />
    </div>
    <div class="loginbox">
        <div class="loginbox-header">
            <h1>Set New Password</h1>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error">
                @TempData["ErrorMessage"]
            </div>
        }

    <form action="/Login/SetPasswordSubmit" method="post" class="loginform">
        <div class="form-group">
            <input type="text" id="username" name="username" class="form-input" placeholder="Member Number" value="@ViewBag.Payroll" readonly />
            
        </div>

        <div class="form-group">
            <input type="password" id="password" name="password" class="form-input" onchange="ConfirmInputs()" placeholder="New Password" required />
            <span class="inputerror" id="spanerror">New Password is required *</span>
        </div>

        <div class="form-group">
            <input type="password" id="cpassword" name="cpassword" class="form-input" onchange="ConfirmInputs()" placeholder="Confirm Password" required />
            <span class="inputerror" id="spanerror1">Confirm Password is required *</span>
        </div>

        <div class="form-group">
            <button type="submit" class="loginbutton">Set New Password</button>
        </div>

    </form>
    </div>
</section>


<script>
    function ConfirmInputs() {
        const spanerror = document.getElementById('spanerror');
        const spanerror1 = document.getElementById('spanerror1');
        const cpassword = document.getElementById('cpassword').value;
        const password = document.getElementById('password').value;

        if (!password) {
            spanerror.style.display = 'block';
        }
        if (password) {
            spanerror.style.display = 'none';
        }
        if (!cpassword) {
            spanerror1.style.display = 'block';
        }
        if (cpassword) {
            spanerror1.style.display = 'none';
        }
    }
</script>