@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_LoginsLayout.cshtml";
}

<section class="loginarea">
    <div class="top-side">
        <img src="~/Content/images/generallogo.png" alt="Jumbo Sacco" class="topsidemage" />
    </div>
    <div class="loginbox">
        <div class="loginbox-header">
            <h1>Reset Password</h1>
        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error">
                @TempData["ErrorMessage"]
            </div>
        }

        <form action="/Login/ResetPassSubmit" method="post" class="loginform">
            <!-- Username or Email -->
            <div class="form-group">
                <input type="text" id="username" name="username" class="form-input" onchange="ConfirmInputs()" placeholder="Member Number" required />
                <span class="inputerror" id="spanerror">Member Number is required *</span>
            </div>

            <!-- CAPTCHA -->
            <div class="form-group">
                <input type="text" id="captcha" name="captcha" class="form-input" onchange="ConfirmInputs()" placeholder="CAPTCHA Code" required />
                <span class="inputerror" id="spanerror2">Captcha code is required *</span>
                <div class="captcharea">
                    <img src="@Url.Action("Captcha", "Login")" alt="CAPTCHA Image" id="captchaImage" />
                    <button type="button" onclick="document.getElementById('captchaImage').src='@Url.Action("Captcha", "Login")?' + Math.random();">Refresh Captcha</button>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="form-group">
                <button type="submit" class="loginbutton">Reset Password</button>
            </div>

            <!-- Forgot Password -->
            <div class="form-group">
                <p>Already set your password, <a href="/Login/Index">Click here</a> to log in</p>
            </div>
        </form>
    </div>
</section>


<script>
    function ConfirmInputs() {
        const spanerror = document.getElementById('spanerror');
        const spanerror1 = document.getElementById('spanerror1');
        const spanerror2 = document.getElementById('spanerror2');
        const username = document.getElementById('username').value;
        const payroll = document.getElementById('payroll').value;
        const captcha = document.getElementById('captcha').value;

        if (!username) {
            spanerror.style.display = 'block';
        }
        if (username) {
            spanerror.style.display = 'none';
        }
        if (!payroll) {
            spanerror1.style.display = 'block';
        }
        if (payroll) {
            spanerror1.style.display = 'none';
        }
        if (!captcha) {
            spanerror2.style.display = 'block';
        }
        if (captcha) {
            spanerror2.style.display = 'none';
        }
    }
</script>