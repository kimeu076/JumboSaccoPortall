@{
    ViewBag.Title = "Downloads Center - " + Model.FolderName;
}

@model JumboSaccoPortal.Controllers.DocumentListViewModel

<div class="pageheader">
    <h1>Downloads Center - @Model.FolderName</h1>
    <a href="@Url.Action("Logout", "Dashboard")">
        <i class="fa fa-power-off"></i>
    </a>
</div>
<div class="pagecontent">
    <div class="innercontent">

        <p class="backpbtn"><a href="@Url.Action("Index", "Downloads")" class="backabutton">Back to Folder List</a></p>
        <div class="section-view">
            <div class="documentsarea">

                <h3>Documents in @Model.FolderName</h3>
                @if (Model.Documents.Any())
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>File Name</th>
                                <th>Download</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in Model.Documents)
                            {
                                <tr>
                                    <td>@document.FileName</td>
                                    <td>
                                        <a href="@Url.Action("Download", "Downloads", new { filePath = document.FilePath })" class="btn btn-primary btn-sm">Download</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>No documents found in this folder.</p>
                }
            </div>
        </div>
    </div>
</div>